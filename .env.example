# 🛡️ send21-agent-budget (budget-guard). Leave SEND21_API_KEY empty for mock mode (no account, no money).

# send21 API key for budget-guard ONLY (scopes drafts:write + drafts:read; add webhooks:manage for npm run webhook:register).
# The agent never sees it. No send21 key can move funds.
SEND21_API_KEY=
SEND21_MCP_URL=https://send21.io/mcp
# Shown once when the webhook is created (npm run webhook:register or the send21 web app)
SEND21_WEBHOOK_SECRET=
# Public https:// address that reaches WEBHOOK_PORT (only for npm run webhook:register)
PUBLIC_URL=https://guard.example.com

# The budget: unit, cap, period, per-payment max, recipients, coins
BUDGET_FILE=./budget.json
DATA_FILE=./data/budget-guard.json

# Agent side: MCP on localhost. Two different tokens (openssl rand -hex 24):
# GUARD_TOKEN goes into the agent's MCP config, ADMIN_TOKEN is for you (decline, status).
GUARD_HOST=127.0.0.1
GUARD_PORT=8787
GUARD_TOKEN=
ADMIN_TOKEN=

# send21 side: webhooks. Put your HTTPS reverse proxy in front of this port only.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8788

# Optional: a real LLM for npm run demo -- --llm (any OpenAI-compatible endpoint, e.g. a local model server)
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
